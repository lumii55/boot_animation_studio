{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bas-community-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_CATALOG_ENABLED": "false",
    "CORS_ALLOWED_ORIGINS": "http://127.0.0.1:8088"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bas-community-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
